# Copy to .env and fill in what you need. Everything is optional for a local run.

# OCR provider: auto picks the first configured of gemini, claude, textract, then mock.
OCR_PROVIDER=auto

# Google Gemini (recommended). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# AWS Textract uses the standard AWS credential chain
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Required outside development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENVIRONMENT=development
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Full medicine dataset (place the CSV in ./data). Defaults to the bundled 80-row sample.
# MEDICINE_CSV=/datasets/medicine_names.csv
