# Credentials. The glob matters: text_extraction.py loads
# client_secret_code1.json, which the old exact-name rule did not cover.
resource/client_secret_code*.json
*.json
!.vscode/*.json

# Local dataset (see README - not committed, ~31 MB)
resource/medicine_names.csv

# Evaluation data. Prescription images are patient data - they must never be
# committed. Labels are ignored too since they are derived from those images.
eval/images/
eval/cache/
eval/results/
eval/labels.csv

__pycache__/
*.pyc
.venv/
venv/
error_log.txt
tempCodeRunnerFile.py
temp/
api.py
cropped_image.png

# PyInstaller output
build/
dist/
*.spec
*.exe
*.zip
*.pkg
